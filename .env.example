# Required for AI dream analysis. Recording dreams works without it.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (api.openai.com, Ollama, vLLM, LM Studio, ...).
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model id — must be served by your endpoint's /chat/completions route.
# gpt-oss-120b (default) runs on OpenAI-compatible servers (Ollama, vLLM, LM
# Studio, NVIDIA NIM, ...) but NOT on api.openai.com, which serves it only via
# the Responses API — with the official API, set this to a chat model your key
# can access. Local servers may use e.g. llama3.1.
DREAMBUDDY_MODEL=gpt-oss-120b

# SQLite database file (created on first run).
DREAMBUDDY_DB_PATH=data/dreambuddy.db
